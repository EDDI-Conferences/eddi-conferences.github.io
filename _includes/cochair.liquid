
         <tr>
            <th>
                <h3>Co-Chairs</h3>
            </th>
        </tr>
        {% for person in site.data.committee %}
            {% if person.role == "Co-chair" %}
            <tr>
                <td class="p-1 pl-2 font-weight-light text">
                  {{ person.name}}, {{ person.org}}, {{ person.location}}
                </td>
            </tr>
            {% endif %}
        {% endfor %}


