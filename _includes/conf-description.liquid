<div class="row justify-content-sm-left">
    <div class="col-sm-2 mt-3 mt-md-0">
        {% for eddi in site.data.conferences %}
            {% if page.name == eddi.name %} 
                {% assign host_image_path = eddi.hostimage %}
                {% include figure.liquid loading="eager" path=host_image_path title="eddi host image" class="img-fluid rounded z-depth-1" width="100%" %}
            {% endif %}
        {% endfor %}
    </div>
       
    <div class="col-sm-8 mt-3 mt-md-0">
        <table class="table-cd table-sm table-borderless table-responsive table-cd-map">
        {% for eddi in site.data.conferences %}
            {% if page.name == eddi.name %}
                {% assign program_path = eddi.program %}
                {% assign zenodo_path = eddi.zenodo %}

            <tr>
                <td class="p-1 pr-2 font-weight-bold">
                    <b>Dates</b>
                </td>
                <td class="p-1 pl-2 font-weight-light text">
                    {{ eddi.dates }}
                </td>
            </tr>
                    <tr>
                <td class="p-1 pr-2 font-weight-bold">
                    <b>Venue</b>
                </td>
                <td class="p-1 pl-2 font-weight-light text">
                    {{ eddi.venue }}
                </td>
            </tr>
            <tr>
                <td class="p-1 pr-2 font-weight-bold">
                    <b>Host</b>
                </td>
                <td class="p-1 pl-2 font-weight-light text">
                    {{ eddi.hosts }}
                </td>
            </tr>   
            <tr>
                <td class="p-1 pr-2 font-weight-bold">
                    <b>Program</b>
                </td>
                <td class="p-1 pl-2 font-weight-light text">
                <a href=" {{- eddi.program }}">{{eddi.title}}</a>
                </td>
            </tr>  
            {% if eddi.zenodo %}                 
                <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                     <b>Publications</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light text">
                        <a href=" {{- eddi.zenodo }}">On Zenodo</a>
                    </td>
                </tr> 
            {% endif %}                  
           {% endif %}
        {% endfor %}
        
        </table> 
        <hr>
    </div>
</div>
